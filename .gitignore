node_modules/
dist/
.output/
.nitro/
.env
*.local
.DS_Store

# Raw purchased/downloaded CraftPix source packs (PSDs + full icon sets, ~800MB).
# Only the curated derivatives we actually ship live in packages/client/public/assets/ui/.
packages/ui/

# Generated collision geometry (per-model triangle soup for BVH collision).
# Pure function of the committed source models; regenerated via
# `pnpm collision:extract` (auto-run on predev/prebuild when missing).
packages/client/public/assets/collision/

# Bundled asset pack (concatenation of every .glb) + its offset index. Pure
# build artifacts derived from the source models -- regenerated by
# `pnpm pack:assets` (auto-run on predev/prebuild). The pack is ~400MB, over
# GitHub's 100MB/file limit, so it must never be committed; the client falls
# back to per-file GETs when it's absent (see render/assetPack.ts).
packages/client/public/assets/assets.rcpack
packages/client/public/assets/assets_index.json
